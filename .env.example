# Copy to .env and adjust. Nothing secret should ever be committed.

# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=django-insecure-dev-key-not-for-production
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# Database. Leave DATABASE_URL unset for the zero-setup SQLite fallback (D5);
# set it to use PostgreSQL, e.g. the docker-compose service below.
# DATABASE_URL=postgres://democrance:democrance@localhost:5432/democrance

# Reviewer convenience (D4): when true, the seven diagram endpoints are open
# without authentication so a bare curl satisfies the acceptance criteria.
# MUST be false in any real deployment.
DEMO_OPEN_API=true

# Domain
DEFAULT_CURRENCY=AED
